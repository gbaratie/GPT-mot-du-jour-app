{
  "name": "Daily Collections",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "postCreateCommand": "make install && make migrate && make sync-content",
  "forwardPorts": [3000, 8000],
  "portsAttributes": { "3000": { "label": "Web" }, "8000": { "label": "API" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint"]
    }
  }
}
