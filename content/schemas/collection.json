{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Coverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "slug": {
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "kind": {
      "enum": [
        "word",
        "quote",
        "riddle"
      ],
      "title": "Kind",
      "type": "string"
    },
    "locale": {
      "pattern": "^[a-z]{2,3}-[A-Z]{2}$",
      "title": "Locale",
      "type": "string"
    },
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    },
    "sort_order": {
      "default": 0,
      "minimum": 0,
      "title": "Sort Order",
      "type": "integer"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    }
  },
  "required": [
    "slug",
    "name",
    "description",
    "kind",
    "locale",
    "coverage"
  ],
  "title": "CollectionDefinition",
  "type": "object"
}
