# Exporter ces valeurs dans le shell ; aucune lecture implicite du fichier .env.
# URL Neon uniquement côté API ; ne jamais utiliser le préfixe NEXT_PUBLIC_ pour un secret.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Europe/Paris

# Variables du front : publiques et figées au build.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BASE_PATH=
