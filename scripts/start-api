#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."
: "${DATABASE_URL:?Configurer DATABASE_URL avant de démarrer le service hébergé}"
: "${CORS_ORIGINS:?Configurer les origines autorisées avant de démarrer le service hébergé}"
alembic -c apps/api/alembic.ini upgrade head
daily-content sync
exec uvicorn app.main:app --host 0.0.0.0 --port "${PORT:-8000}"
